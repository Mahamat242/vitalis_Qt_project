{
  "version": 3,
  "configurePresets": [
    {
      "name": "qt-mingw64",
      "displayName": "Qt 6.11.1 MinGW 64-bit",
      "description": "Configuration avec le compilateur MinGW fourni par Qt",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cmakeExecutable": "C:/Qt/Tools/CMake_64/bin/cmake.exe",
      "environment": {
        "PATH": "C:/Qt/6.11.1/mingw_64/bin;C:/Qt/Tools/mingw1310_64/bin;C:/Qt/Tools/Ninja;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "C:/Qt/6.11.1/mingw_64",
        "CMAKE_C_COMPILER": "C:/Qt/Tools/mingw1310_64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/Qt/Tools/mingw1310_64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "C:/Qt/Tools/Ninja/ninja.exe"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "qt-mingw64",
      "displayName": "Build Qt 6.11.1 MinGW",
      "configurePreset": "qt-mingw64"
    }
  ]
}
